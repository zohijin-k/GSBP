# 명의대여 판별 화면의 설명 문장 생성에 쓰인다.
# 비워 두면 규칙 기반 폴백 문장으로 동작한다 — 화면은 정상적으로 뜬다.
ANTHROPIC_API_KEY=

# 비우면 lib/prompt.ts 의 DEFAULT_MODEL(claude-opus-5)을 쓴다.
GSB_MODEL=

# LLM 호출을 허용할 호스트 목록(콤마 구분). 비우면 검사를 생략한다(로컬 개발용).
# 목록 밖에서 온 요청은 차단하지 않고 폴백으로 강등된다 — 비용은 막되 화면은 살린다.
GSB_ALLOWED_ORIGINS=your-domain.vercel.app

# 배포 도메인. metadata/openGraph 의 절대 URL 생성에 쓴다.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
